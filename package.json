    "prisma:dev:studio": "dotenv -e .env.local -- npx prisma studio",
    "prisma:dev:pull": "dotenv -e .env.local -- npx prisma db pull",
    "prisma:prod:validate": "dotenv -e .env -- npx prisma validate",
    "prisma:prod:deploy": "dotenv -e .env -- npx prisma migrate deploy",
    "prisma:prod:pull": "dotenv -e .env -- npx prisma db pull",
    "prisma:prod:studio": "dotenv -e .env -- npx prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "lucide-react": "^0.510.0",
    "next": "15.3.2",
    "posthog-js": "^1.265.1",
    "posthog-node": "^5.8.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.2",
    "prisma": "^6.12.0",
